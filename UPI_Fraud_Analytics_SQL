--DATA CLEANING ----------------

CREATE SCHEMA IF NOT EXISTS UPI_FRAUD_ANALYTICS.CURATED;
SHOW SCHEMAS IN DATABASE UPI_FRAUD_ANALYTICS;

---Purpose: Create the cleaned transaction table in CURATED using the same cleaning logic we applied in Databricks.

--Step 1 - Data Preparation Step 1--Create the CURATED schema where we will store the cleaned data.

CREATE OR REPLACE TABLE UPI_FRAUD_ANALYTICS.CURATED.TRANSACTIONS_CURATED AS
SELECT
    *,
    
    CASE
        WHEN TIME_SINCE_LAST_TXN_MIN < 0 THEN NULL
        ELSE TIME_SINCE_LAST_TXN_MIN
    END AS CLEAN_TIME_SINCE_LAST_TXN_MIN,

    CASE
        WHEN TRANSACTION_VELOCITY IS NULL THEN 0
        ELSE TRANSACTION_VELOCITY
    END AS CLEAN_TRANSACTION_VELOCITY,

    CASE
        WHEN AMOUNT_DEVIATION_SCORE IS NULL THEN 0.4445
        ELSE AMOUNT_DEVIATION_SCORE
    END AS CLEAN_AMOUNT_DEVIATION_SCORE,

    CASE
        WHEN TIME_SINCE_LAST_TXN_MIN IS NULL
             OR TIME_SINCE_LAST_TXN_MIN < 0
        THEN 1
        ELSE 0
    END AS TIME_SINCE_LAST_TXN_MISSING_FLAG,

    CASE
        WHEN HOUR_OF_DAY BETWEEN 5 AND 11 THEN 'Morning'
        WHEN HOUR_OF_DAY BETWEEN 12 AND 16 THEN 'Afternoon'
        WHEN HOUR_OF_DAY BETWEEN 17 AND 20 THEN 'Evening'
        ELSE 'Night'
    END AS TIME_PERIOD,

    CASE
        WHEN AMOUNT < 500 THEN 'Low'
        WHEN AMOUNT < 2000 THEN 'Medium'
        WHEN AMOUNT < 5000 THEN 'High'
        ELSE 'Very High'
    END AS AMOUNT_CATEGORY

FROM UPI_FRAUD_ANALYTICS.RAW_DATA.TRANSACTIONS;

    --Data Cleaning Step 2
    --Negative values → NULL, Do not delete the transactions, Keep a missing-value indicator for later analysis

    UPDATE UPI_FRAUD_ANALYTICS.CURATED.TRANSACTIONS_CURATED
    SET TIME_SINCE_LAST_TXN_MIN = NULL
    WHERE TIME_SINCE_LAST_TXN_MIN < 0;

    --Verify

    SELECT COUNT(*) AS NEGATIVE_TIME_VALUES
   FROM UPI_FRAUD_ANALYTICS.CURATED.TRANSACTIONS_CURATED
   WHERE TIME_SINCE_LAST_TXN_MIN < 0;

   -— Data Cleaning Step 3
--Handle the missing TRANSACTION_VELOCITY values, using the same decision we made in Databricks.
--We decided to replace the 393 missing values with 0 because the existing values were in the range 0–4 and 0 was the most frequent value.

UPDATE UPI_FRAUD_ANALYTICS.CURATED.TRANSACTIONS_CURATED
SET TRANSACTION_VELOCITY = 0
WHERE TRANSACTION_VELOCITY IS NULL;

--verify
SELECT COUNT(*) AS NULL_TRANSACTION_VELOCITY
FROM UPI_FRAUD_ANALYTICS.CURATED.TRANSACTIONS_CURATED
WHERE TRANSACTION_VELOCITY IS NULL;

-— Data Cleaning Step --

--Handle the missing AMOUNT_DEVIATION_SCORE values, using the same cleaning decision from Databricks.
-- found 367 missing values and used the median value 0.4445.

UPDATE UPI_FRAUD_ANALYTICS.CURATED.TRANSACTIONS_CURATED
SET AMOUNT_DEVIATION_SCORE = 0.4445
WHERE AMOUNT_DEVIATION_SCORE IS NULL;

--verify
SELECT COUNT(*) AS NULL_AMOUNT_DEVIATION
FROM UPI_FRAUD_ANALYTICS.CURATED.TRANSACTIONS_CURATED
WHERE AMOUNT_DEVIATION_SCORE IS NULL;

--Data Cleaning Step 5
--Create the missing-value flag for TIME_SINCE_LAST_TXN_MIN, so we retain information about which transactions originally had missing/invalid time-gap values.
--Because we already converted the negative values to NULL, this flag should be created now.

UPDATE UPI_FRAUD_ANALYTICS.CURATED.TRANSACTIONS_CURATED
SET TIME_SINCE_LAST_TXN_MISSING_FLAG =
    CASE
        WHEN TIME_SINCE_LAST_TXN_MIN IS NULL THEN 1
        ELSE 0
    END;

--verify
SELECT
    TIME_SINCE_LAST_TXN_MISSING_FLAG,
    COUNT(*) AS TRANSACTION_COUNT
FROM UPI_FRAUD_ANALYTICS.CURATED.TRANSACTIONS_CURATED
GROUP BY TIME_SINCE_LAST_TXN_MISSING_FLAG
ORDER BY TIME_SINCE_LAST_TXN_MISSING_FLAG;

----Final Cleaning Validation---------
--Step 1 — Final Cleaning Validation

SELECT
    COUNT(*) AS TOTAL_ROWS,
    COUNT_IF(TIME_SINCE_LAST_TXN_MIN < 0) AS NEGATIVE_TIME_VALUES,
    COUNT_IF(TRANSACTION_VELOCITY IS NULL) AS NULL_TRANSACTION_VELOCITY,
    COUNT_IF(AMOUNT_DEVIATION_SCORE IS NULL) AS NULL_AMOUNT_DEVIATION,
    COUNT_IF(AMOUNT <= 0) AS INVALID_AMOUNTS,
    COUNT_IF(IS_FRAUD NOT IN (0,1)) AS INVALID_FRAUD_FLAGS
FROM UPI_FRAUD_ANALYTICS.CURATED.TRANSACTIONS_CURATED;

